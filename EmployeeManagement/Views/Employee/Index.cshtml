@model List<EmployeeManagement.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold mb-1">Employees</h1>
        <p class="text-muted mb-0">
            Manage your employees and their information.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Employee
    </a>

</div>


<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <form asp-action="Index" method="get">

            <div class="row g-2">

                <div class="col-md-3">

                    <select name="searchBy" class="form-select">

                        <option value="FirstName">
                            First Name
                        </option>

                        <option value="LastName">
                            Last Name
                        </option>

                        <option value="EmailAddress">
                            Email Address
                        </option>

                        <option value="Address">
                            Address
                        </option>

                    </select>

                </div>


                <div class="col-md-7">

                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search employees..." />

                </div>


                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Search
                    </button>

                </div>

            </div>

        </form>

    </div>

</div>


<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">

                <h5 class="fw-semibold">
                    No employees found
                </h5>

                <p class="text-muted">
                    There are currently no employees matching your search.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Add Employee
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="ps-4">Name</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Created</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var employee in Model)
                        {
                            <tr>

                                <td class="ps-4">

                                    <div class="fw-semibold">

                                        @employee.FirstName

                                        @if (!string.IsNullOrWhiteSpace(employee.MiddleName))
                                        {
                                            @($" {employee.MiddleName}")
                                        }

                                        @($" {employee.LastName}")

                                    </div>

                                </td>


                                <td>
                                    @employee.EmailAddress
                                </td>


                                <td>
                                    @employee.Address
                                </td>


                                <td>
                                    @employee.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                </td>


                                <td class="text-end pe-4">

                                    <a asp-action="Details"
                                       asp-route-id="@employee.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        View
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@employee.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@employee.Id"
                                          method="post"
                                          class="d-inline">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this employee?');">
                                            Delete
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>